{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "initialVersion": "1.0.0",
  "plugins": [
    "./scripts/manual-release-override.cjs",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          "dist/*.tgz"
        ]
      }
    ]
  ]
}
