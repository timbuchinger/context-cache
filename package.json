{
  "name": "context-cache",
  "version": "1.0.0",
  "description": "Memory storage and retrieval system for AI agents using hybrid search",
  "main": "dist/index.js",
  "bin": {
    "cc-kb-index": "dist/indexer-cli.js",
    "cc-kb-search": "dist/search-cli.js",
    "cc-conversations-index": "dist/cli/conversation-cli.js",
    "cc-conversations-search": "dist/cli/conversations-search-cli.js",
    "cc-stats": "dist/stats-cli.js",
    "cc-reset": "dist/reset-cli.js",
    "cc-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
