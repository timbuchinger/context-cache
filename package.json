    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "semantic-release": "^25.0.7",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
